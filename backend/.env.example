# Local dev (via `supabase start`): copy this file to .env — Supabase is
# used only as a hosted Postgres provider here, not its SDK/Auth. This is
# the direct Postgres connection string from `supabase start`'s output
# (also shown by `npx supabase status`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Auth: there's no real way to produce a Cloudflare Access-signed
# assertion outside Cloudflare's own infrastructure, so local dev
# authenticates as a fixed identity instead of verifying a real one.
# Never set this in the deployed environment.
DEV_USER_EMAIL=you@example.com

# Prod — fill these in with real values, never commit them. DATABASE_URL
# is Supabase's direct Postgres connection string (Project Settings ->
# Database); CF_ACCESS_* come from the Access Application in the
# Cloudflare Zero Trust dashboard. DEV_USER_EMAIL must NOT be set here.
# DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
# CF_ACCESS_TEAM_DOMAIN=<your-team>.cloudflareaccess.com
# CF_ACCESS_AUD=<application-audience-tag>
