# Local dev: copy this file to .env. The SQLite file path defaults to
# ./data/learn.db (relative to the backend process's cwd) if unset, so
# this only needs setting to point somewhere else.
# DATABASE_PATH=./data/learn.db

# There's no separate auth to configure — identity is just the email the
# client sends with each request (X-User-Email), entered once in the
# app's UI and stored in the browser. Nothing to set here for it.

# Prod — fill this in with a real value, never commit it. DATABASE_PATH
# should point at a path on a persistent volume (the SQLite file must
# survive container restarts/redeploys).
# DATABASE_PATH=/data/learn.db
